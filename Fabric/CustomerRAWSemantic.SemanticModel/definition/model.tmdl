ref table dim_country
ref table dim_customer
ref table dim_date
ref table dim_product
ref table fact_customer_transactions
ref table fact_txn_lc
ref table fact_web_events
ref table lkp_age_bucket
ref table lkp_country_bucket

ref role LocalCustomers

